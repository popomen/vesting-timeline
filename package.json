{
  "name": "vesting-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:demo": "node scripts/build_cloudflare.mjs --demo",
    "build:private": "node scripts/build_cloudflare.mjs --private",
    "check:deploy": "npm run build:demo && wrangler deploy --dry-run --outdir .work/cloudflare/worker",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login",
    "cf:dev": "npm run build:demo && wrangler dev --local",
    "cb:build:demo": "node scripts/build_cloudbase.mjs --demo",
    "cb:build:private": "node scripts/build_cloudbase.mjs --private",
    "cb:login": "tcb login --flow device",
    "cb:envs": "tcb env list --region ap-shanghai --json"
  },
  "dependencies": {
    "d3": "7.9.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.4",
    "wrangler": "4.141.0"
  }
}
